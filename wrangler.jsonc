{
  "name": "the-calm-nest",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-calm-nest-db",
      "database_id": "0629c0cd-9b16-47bc-84ef-250390104b15"
    }
  ]
}